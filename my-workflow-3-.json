        "responseBody": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n\n  <style>\n    /* Degradado basado en la imagen adjunta (azules y verdes) */\n    body {\n      background: linear-gradient(to bottom, #004e92, #0a7d68);\n    }\n  </style>\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center p-6\">\n\n  <form \n    action=\"https://hpa.lugnia.com/webhook/12345\"\n    method=\"POST\"\n    class=\"w-full max-w-lg bg-white/10 backdrop-blur-md p-8 rounded-2xl shadow-xl text-white space-y-6\"\n  >\n    <h2 class=\"text-2xl font-bold mb-4\">Formulario de registro</h2>\n\n    <!-- Nombre -->\n    <div>\n      <label class=\"block mb-1 font-semibold\">Nombre *</label>\n      <input \n        type=\"text\" \n        name=\"nombre\" \n        required\n        class=\"w-full p-3 rounded-lg bg-white/20 focus:bg-white/30 outline-none\"\n      />\n    </div>\n\n    <!-- País -->\n    <div>\n      <label class=\"block mb-1 font-semibold\">País *</label>\n      <input \n        type=\"text\" \n        name=\"pais\" \n        required\n        class=\"w-full p-3 rounded-lg bg-white/20 focus:bg-white/30 outline-none\"\n      />\n    </div>\n\n    <!-- Género -->\n    <div>\n      <label class=\"block mb-1 font-semibold\">Género *</label>\n      <select \n        name=\"genero\" \n        required\n        class=\"w-full p-3 rounded-lg bg-white/20 focus:bg-white/30 outline-none text-black\"\n      >\n        <option value=\"\" disabled selected>Selecciona una opción</option>\n        <option value=\"masculino\">Masculino</option>\n        <option value=\"femenino\">Femenino</option>\n        <option value=\"otro\">Otro</option>\n      </select>\n    </div>\n\n    <!-- Comida favorita -->\n    <div>\n      <label class=\"block mb-1 font-semibold\">Comida favorita *</label>\n      <select \n        name=\"comida_favorita\" \n        required\n        class=\"w-full p-3 rounded-lg bg-white/20 focus:bg-white/30 outline-none text-black\"\n      >\n        <option value=\"\" disabled selected>Selecciona una opción</option>\n        <option value=\"italiana\">Italiana</option>\n        <option value=\"mexicana\">Mexicana</option>\n        <option value=\"colombiana\">Colombiana</option>\n        <option value=\"peruana\">Peruana</option>\n        <option value=\"espanola\">Española</option>\n      </select>\n    </div>\n\n    <!-- Email -->\n    <div>\n      <label class=\"block mb-1 font-semibold\">Email *</label>\n      <input \n        type=\"email\" \n        id=\"email\" \n        name=\"email\" \n        required\n        class=\"w-full p-3 rounded-lg bg-white/20 focus:bg-white/30 outline-none\"\n      />\n    </div>\n\n    <!-- Confirmar email -->\n    <div>\n      <label class=\"block mb-1 font-semibold\">Confirmar email *</label>\n      <input \n        type=\"email\" \n        id=\"email_confirm\" \n        name=\"email_confirm\" \n        required\n        class=\"w-full p-3 rounded-lg bg-white/20 focus:bg-white/30 outline-none\"\n      />\n      <p id=\"emailError\" class=\"text-red-300 text-sm mt-1 hidden\">Los correos no coinciden</p>\n    </div>\n\n    <!-- Submit -->\n    <button \n      type=\"submit\"\n      class=\"w-full bg-white text-blue-800 font-bold py-3 rounded-lg hover:bg-gray-100 transition\"\n    >\n      Enviar\n    </button>\n  </form>\n\n  <!-- Validación de coincidencia de email -->\n  <script>\n    const email = document.getElementById(\"email\");\n    const emailConfirm = document.getElementById(\"email_confirm\");\n    const errorMsg = document.getElementById(\"emailError\");\n\n    emailConfirm.addEventListener(\"input\", () => {\n      if (email.value !== emailConfirm.value) {\n        errorMsg.classList.remove(\"hidden\");\n        emailConfirm.setCustomValidity(\"Los emails no coinciden\");\n      } else {\n        errorMsg.classList.add(\"hidden\");\n        emailConfirm.setCustomValidity(\"\");\n      }\n    });\n  </script>\n\n</body>\n</html>\n",
