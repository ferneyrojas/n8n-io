    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\" />\n<title>Panel n8n</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n\n<body class=\"bg-gray-100 p-6\">\n\n<div id=\"mainMenu\" class=\"max-w-xl mx-auto bg-white p-6 rounded-xl shadow\">\n  <h1 class=\"text-xl font-bold mb-4\">Panel de acciones</h1>\n\n  <div class=\"flex flex-col gap-3\">\n    <button onclick=\"showForm()\" class=\"bg-blue-600 text-white py-2 px-4 rounded-lg\">Crear estructura infografías</button>\n    <button class=\"bg-gray-600 text-white py-2 px-4 rounded-lg\">Otra acción</button>\n    <button class=\"bg-gray-600 text-white py-2 px-4 rounded-lg\">Otra acción 2</button>\n  </div>\n</div>\n\n<!-- FORMULARIO OCULTO -->\n<div id=\"formContainer\" class=\"hidden max-w-xl mx-auto bg-white p-6 rounded-xl shadow\">\n  \n  <button onclick=\"showMenu()\" class=\"text-blue-600 mb-4 flex items-center\">\n    ← Volver\n  </button>\n\n  <h2 class=\"text-lg font-semibold mb-4\">Crear estructura infografía</h2>\n\n  <form method=\"POST\" action=\"https://hpa.lugnia.com/webhook/infografias-ia\">\n\n    <!-- Nombre -->\n    <label class=\"block mb-2 font-medium\">Nombre</label>\n    <input type=\"text\" name=\"inf_nombre\" class=\"w-full border px-3 py-2 rounded mb-4\" required />\n\n    <!-- Proyecto -->\n    <label class=\"block mb-2 font-medium\">Proyecto</label>\n    <select name=\"inf_proyecto\" class=\"w-full border px-3 py-2 rounded mb-4\">\n      <option value=\"1\">Virtualpro</option>\n      <option value=\"2\">Virtualplant</option>\n      <option value=\"3\">Erosky</option>\n      <option value=\"4\">Phet</option>\n    </select>\n\n    <!-- Plantilla -->\n    <label class=\"block mb-2 font-medium\">Plantilla</label>\n    <select name=\"inf_plantilla\" class=\"w-full border px-3 py-2 rounded mb-4\">\n      <option value=\"1\">Virtualpro</option>\n      <option value=\"2\">Virtualplant</option>\n      <option value=\"3\">Guía de laboratorio</option>\n      <option value=\"4\">Laboratorio</option>\n      <option value=\"5\">Info V2</option>\n    </select>\n\n    <!-- Fuente -->\n    <label class=\"block mb-2 font-medium\">Fuente</label>\n    <select name=\"inf_font\" class=\"w-full border px-3 py-2 rounded mb-4\">\n      <option value=\"1\">Arial</option>\n      <option value=\"2\">Monospace</option>\n      <option value=\"3\">Helvética</option>\n      <option value=\"4\">Sans-serif</option>\n      <option value=\"5\">Serif</option>\n      <option value=\"6\">Courier</option>\n      <option value=\"7\">Hanalei</option>\n    </select>\n\n    <!-- Colores -->\n    <label class=\"block mb-2 font-medium\">Color base</label>\n    <input type=\"text\" name=\"inf_color\" value=\"#000000\" class=\"w-full border px-3 py-2 rounded mb-4\" />\n\n    <label class=\"block mb-2 font-medium\">Color secundario</label>\n    <input type=\"text\" name=\"inf_color_secundario\" value=\"#000000\" class=\"w-full border px-3 py-2 rounded mb-4\" />\n\n    <!-- Checkbox -->\n    <label class=\"flex items-center gap-2 mb-4\">\n      <input type=\"checkbox\" name=\"inf_activo\" value=\"true\" />\n      Activo\n    </label>\n\n    <!-- Descripción -->\n    <label class=\"block mb-2 font-medium\">Descripción</label>\n    <textarea name=\"inf_descripcion\" class=\"w-full border px-3 py-2 rounded mb-4\"></textarea>\n\n    <!-- Tipo infografía -->\n    <label class=\"block mb-2 font-medium\">Tipo de infografía</label>\n    <select name=\"inf_tipo_infografia\" class=\"w-full border px-3 py-2 rounded mb-4\">\n      <option value=\"1\">Infografía</option>\n      <option value=\"2\">Proceso</option>\n      <option value=\"3\">Perfil</option>\n      <option value=\"4\">Escenario</option>\n    </select>\n\n    <button type=\"submit\" class=\"bg-green-600 text-white py-2 px-4 rounded-lg w-full\">\n      Enviar\n    </button>\n  </form>\n\n</div>\n\n<script>\nfunction showForm() {\n  document.getElementById('mainMenu').classList.add('hidden');\n  document.getElementById('formContainer').classList.remove('hidden');\n}\n\nfunction showMenu() {\n  document.getElementById('formContainer').classList.add('hidden');\n  document.getElementById('mainMenu').classList.remove('hidden');\n}\n</script>\n\n</body>\n</html>\n",
