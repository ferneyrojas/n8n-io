    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body.content;\nconst images = [];\n\nfunction findImages(elements) {\n  for (const el of elements) {\n    if (el.paragraph && el.paragraph.elements) {\n      for (const e of el.paragraph.elements) {\n        if (e.inlineObjectElement) {\n          images.push(e.inlineObjectElement.inlineObjectId);\n        }\n      }\n    }\n    if (el.table) {\n      el.table.tableRows.forEach(row =>\n        row.tableCells.forEach(cell => findImages(cell.content))\n      );\n    }\n  }\n}\n\nfindImages(body);\nreturn images.map(id => ({ json: { inlineObjectId: id } }));\n"
      },
