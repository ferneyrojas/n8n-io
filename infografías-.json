      "name": "Code in JavaScript10"
    },
    {
      "parameters": {
        "jsCode": "const tri_id = $json.tri_id;\nconst trivia = $json.trivia;\n\nconst items = trivia.map(q => {\n  return {\n    json: {\n      tri_id: tri_id,\n      pregunta: `<p>${q.pregunta}</p>`,\n      respuestas: q.respuestas\n    }\n  };\n});\n\nreturn items;\n"
      },
