    {
      "parameters": {
        "jsCode": "// Function node (Parse JSON) - pega esto en el nodo Function\nconst out = [];\n\n/** Recopila todos los strings dentro del objeto (busca en keys/arrays) */\nfunction collectStrings(obj, acc = []) {\n  if (obj == null) return acc;\n  if (typeof obj === 'string') { acc.push(obj); return acc; }\n  if (Array.isArray(obj)) {\n    for (const v of obj) collectStrings(v, acc);\n  } else if (typeof obj === 'object') {\n    for (const k of Object.keys(obj)) collectStrings(obj[k], acc);\n  }\n  return acc;\n}\n\n/** Extrae una subcadena JSON balanceada (soporta { ... } y [ ... ]).\n *  Devuelve null si no encuentra cierre balanceado. */\nfunction extractBalanced(s) {\n  const start = s.search(/[{[]/);\n  if (start === -1) return null;\n  const open = s[start];\n  const close = open === '{' ? '}' : ']';\n  let depth = 0;\n  let inString = false;\n  let prev = '';\n  for (let i = start; i < s.length; i++) {\n    const ch = s[i];\n    if (ch === '\"' && prev !== '\\\\') inString = !inString;\n    if (!inString) {\n      if (ch === open) depth++;\n      else if (ch === close) {\n        depth--;\n        if (depth === 0) return s.slice(start, i + 1);\n      }\n    }\n    prev = ch;\n  }\n  // Si aquí no está balanceado, intenta devolver hasta la última llave/corchete\n  const lastClose = s.lastIndexOf(close);\n  if (lastClose > start) return s.slice(start, lastClose + 1);\n  return null;\n}\n\n/** Intento de parse seguro */\nfunction tryJSONParse(s) {\n  try { return JSON.parse(s); } catch (e) { return null; }\n}\n\n// ---- comienzo ----\nconst item = items[0] ? items[0].json : {};\nconst candidates = collectStrings(item);\n\n// Si no hay strings, usa la representación JSON del objeto\nconst rawCandidate = (candidates.length ? candidates : [JSON.stringify(item)]).sort((a,b) => {\n  // Prioriza candidatos que contengan \"temas\" y llaves\n  const score = s => (s.includes('\"temas\"') ? 10 : 0) + (s.includes('{') ? 1 : 0);\n  return score(b) - score(a);\n})[0];\n\nlet parsed = null;\n\n// 1) intenta extraer bloque balanceado y parsear\nconst balanced = extractBalanced(rawCandidate);\nif (balanced) parsed = tryJSONParse(balanced);\n\n// 2) si falla, intenta \"unescape\" de \\n y \\\"\nif (!parsed) {\n  const unesc = rawCandidate.replace(/\\\\n/g, '\\n').replace(/\\\\\"/g, '\"');\n  const balanced2 = extractBalanced(unesc) || unesc;\n  parsed = tryJSONParse(balanced2);\n}\n\n// 3) si aún falla, busca la clave \"temas\" y recorta desde la llave previa\nif (!parsed) {\n  const keyIdx = rawCandidate.search(/\"temas\"\\s*:/);\n  if (keyIdx !== -1) {\n    const braceIdx = rawCandidate.lastIndexOf('{', keyIdx);\n    if (braceIdx !== -1) {\n      const substr = rawCandidate.slice(braceIdx);\n      const balanced3 = extractBalanced(substr) || substr;\n      parsed = tryJSONParse(balanced3);\n    }\n  }\n}\n\n// 4) salida: si parseó, devuelve el objeto; si no, devuelve raw para debug\nif (!parsed) {\n  out.push({\n    json: {\n      success: false,\n      error: 'No se pudo parsear JSON. Revisa el campo raw para depuración.',\n      raw: rawCandidate\n    }\n  });\n  return out;\n}\n\n// Si parseó correctamente, devolvemos el objeto (ej: { temas: [...] })\nout.push({ json: parsed });\nreturn out[0].json.temas.map(t => ({ json: t }));\n\n"
      },
