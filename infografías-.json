    {
      "parameters": {
        "jsCode": "const out = [];\n\nfor (const item of items) {\n  const subId = item.json.sub_id;\n  const nombre = item.json.nombre || \"\";\n  const parrafos = Array.isArray(item.json.contenido) ? item.json.contenido : [item.json.contenido];\n\n  // Determinar plantilla\n  let plantilla = 2; // valor por defecto\n  if (nombre.toLowerCase() === \"portada\") {\n    plantilla = 8;\n  } else if (nombre.toLowerCase() === \"trivia\") {\n    plantilla = 10;\n  }\n\n  parrafos.forEach((texto, idx) => {\n    out.push({\n      json: {\n        sld_activo: true,\n        sld_id_subseccion: subId,\n        sld_nombre: nombre,\n        sld_orden: idx + 1,\n        sld_plantilla: plantilla,\n        sld_texto1: texto ? `<p>${texto}</p>` : \"\", // si no hay texto, vacío\n        sld_titulo: item.json.titulo || nombre\n      }\n    });\n  });\n}\n\nreturn out;\n"
