    {
      "parameters": {
        "jsCode": "// Tomamos todos los items que vienen al nodo\nconst items = $items();\n\n// Buscamos el que trae output y el que trae tri_id\nconst outputItem = items.find(i => i.json.output);\nconst idItem = items.find(i => i.json.tri_id);\n\n// Limpiamos el JSON dentro del output\nlet clean = outputItem.json.output\n  .replace(/```json\\n?/g, '')\n  .replace(/```/g, '');\n\n// Parseamos\nlet trivia;\ntry {\n  trivia = JSON.parse(clean);\n} catch (err) {\n  throw new Error('Error parseando la trivia: ' + err.message + '\\nTexto:\\n' + clean);\n}\n\n// Devolvemos un solo objeto que combine ambas cosas\nreturn [{\n  json: {\n    tri_id: idItem.json.tri_id,\n    trivia: trivia\n  }\n}];\n"
      },
