      "parameters": {
        "jsCode": "// Busca el primer item que tenga prompt definido\nconst promptItem = items.find(i => i.json.prompt);\n\nreturn [\n  {\n    json: {\n      model: \"google/gemini-2.5-flash-image-preview\",\n      max_tokens: 256, // ✅ esta es la clave correcta\n      messages: [\n        {\n          role: \"user\",\n          content: [\n            {\n              type: \"text\",\n              text: promptItem ? promptItem.json.prompt : \"Genera una imagen sencilla\"\n            }\n          ]\n        }\n      ]\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2192,
        720
      ],
      "id": "0872b874-0613-478a-95b2-3912cfa85f76",
      "name": "Code in JavaScript3"
