        "jsCode": "const items = $items(); // todos los items que entran al nodo\nconst data = items.map(i => i.json); // extraemos el JSON de cada item\nconst result = [];\n\n(data || []).forEach(p => {\n  (p.respuestas || []).forEach(r => {\n    result.push({\n      json: {\n        trr_id_pregunta: p.trp_id,          // ID de la pregunta\n        trr_respuesta: `<p>${r.texto}</p>`, // respuesta envuelta en <p>\n        correcta: r.correcta\n      }\n    });\n  });\n});\n\nreturn result;\n"
