        "jsCode": "const out = [];\n\nfor (const item of items) {\n  const temaId = item.json.sec_id;\n  const subtemas = item.json.subtemas || [];\n\n  subtemas.forEach((st, idx) => {\n    out.push({\n      json: {\n        idTema: temaId,\n        nombre: st.nombre,\n        contenido: st.contenido || \"\", // array de párrafos\n        orden: idx + 1,\n        titulo: st.titulo || st.nombre\n      }\n    });\n  });\n}\n\nreturn out;\n"
