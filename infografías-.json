    {
      "parameters": {
        "jsCode": "// Accedemos al mensaje de la primera choice\nconst choice = $json.choices?.[0];\nconst image = choice?.message?.images?.[0];\n\nif (!image) {\n  throw new Error(\"No se encontró ninguna imagen en la respuesta.\");\n}\n\n// Obtenemos el Data URL de la respuesta\nconst dataUrl = image.image_url.url;\n\n// Extraemos solo la parte base64 (quitamos el prefijo data:image/png;base64,)\nconst base64 = dataUrl.split(\",\")[1];\n\n// Convertimos a Buffer\nconst buffer = Buffer.from(base64, \"base64\");\n\n// Retornamos en formato que n8n entiende como archivo binario\nreturn {\n  json: {\n    filename: \"imagen.png\",\n  },\n  binary: {\n    data: {\n      data: buffer.toString(\"base64\"), // n8n espera base64 en binarios\n      mimeType: \"image/png\",\n      fileName: \"imagen.png\",\n    },\n  },\n};\n"
      },
