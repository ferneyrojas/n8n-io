        "jsCode": "let recursoId = null;\n\n// Buscar el recurso (el item que contiene campos rec_)\nfor (const it of items) {\n  const j = it.json || {};\n  const hasRec = Object.keys(j).some(k => k.startsWith(\"rec_\"));\n  if (hasRec && j.id !== undefined) {\n    recursoId = j.id;\n    break; // asumimos que solo hay uno\n  }\n}\n\n// Filtramos los items que no son recurso y que no tengan \"prompt\"\nconst filtered = items.filter(it => {\n  const j = it.json || {};\n  const hasRec = Object.keys(j).some(k => k.startsWith(\"rec_\"));\n  const hasPrompt = \"prompt\" in j;\n  return !hasRec && !hasPrompt;\n});\n\n// Agrupamos por sld_nombre\nconst grouped = {};\nfor (const it of filtered) {\n  const j = { ...it.json };\n\n  if (!j.sld_nombre) continue;\n\n  if (!grouped[j.sld_nombre]) {\n    grouped[j.sld_nombre] = { ...j, sld_texto1: j.sld_texto1 || \"\" };\n  } else {\n    grouped[j.sld_nombre].sld_texto1 += (grouped[j.sld_nombre].sld_texto1 ? \"\\n\\n\" : \"\") + (j.sld_texto1 || \"\");\n    // mantener el menor orden para representar el primero\n    if (j.sld_orden < grouped[j.sld_nombre].sld_orden) {\n      grouped[j.sld_nombre].sld_orden = j.sld_orden;\n    }\n  }\n}\n\n// Convertimos a array y añadimos sld_fondo si es portada\nconst out = Object.values(grouped).map(j => {\n  if (j.sld_nombre && j.sld_nombre.toLowerCase() === \"portada\" && recursoId) {\n    j.sld_fondo = recursoId;\n  }\n  return { json: j };\n});\n\nreturn out;\n"
      },
