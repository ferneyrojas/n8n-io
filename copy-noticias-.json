      "name": "Extarer Elementos Noticias"
    },
    {
      "parameters": {
        "jsCode": "const {title, url, img, autor, date} = $input.first().json;\n\nconst data = [];\nfor(const index of title.keys()){\n\n  const fecha = new Date(date[index]);\n  const year = fecha.getFullYear();\n  const month = String(fecha.getMonth() + 1).padStart(2, \"0\"); // meses 0-11\n  const day = String(fecha.getDate()).padStart(2, \"0\");\n  const formatted = `${year}-${month}-${day}`;\n  \n  data.push({\n    title: title[index],\n    url: img[index],\n    autor: autor[index],\n    date: formatted\n  })\n}\n\n/*\nconst data = title.map((val, index) => ({\n  title: val,\n  url: img[index],\n  autor: autor[index],\n  date: date[index]\n}));\n*/\n\nreturn data;"
      },
